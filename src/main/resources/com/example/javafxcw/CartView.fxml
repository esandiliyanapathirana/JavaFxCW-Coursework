<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="10" prefHeight="560" prefWidth="800"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.javafxcw.CartController"
      style="-fx-padding: 12;">

    <Label text="Cart / Checkout"/>
    <HBox spacing="8">
        <TextField fx:id="codeField" promptText="Part code"/>
        <TextField fx:id="qtyField" promptText="Quantity"/>
        <Button text="Add to Cart" onAction="#addToCart"/>
        <Button text="Checkout" onAction="#checkout"/>
        <Button text="Clear Cart" onAction="#clearCart"/>
        <Button text="Back to Menu" onAction="#goBackToMenu"/>
    </HBox>
    <ListView fx:id="cartList" prefHeight="300"/>
    <Label fx:id="totalLabel" text="Total: Rs. 0.00"/>
    <Label fx:id="messageLabel" text=""/>
</VBox>